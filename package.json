{
  "name": "wdio-jest",
  "version": "2.0.0",
  "description": "WebdriverIO boilerplate using WebdriverIO, Jest and Wiremock",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings 0",
    "validate": "npm run lint:check && npm test"
  },
  "author": "Erwin Heitzman",
  "license": "MIT",
  "dependencies": {
    "@types/node-fetch": "^2.6.12",
    "@wdio/globals": "^9.16.2",
    "expect-webdriverio": "file:.yalc/expect-webdriverio",
    "jest": "^29.7.0",
    "lodash.zip": "^4.2.0",
    "node-fetch": "^3.3.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3",
    "wdio-wiremock-service": "^7.0.2",
    "webdriverio": "^9.16.2"
  },
  "overrides": {
    "expect-webdriverio": "file:.yalc/expect-webdriverio"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-wdio": "^9.16.2"
  }
}
